  <releases>
    <release version="3.2.9a" date="2024-12-30">
      <description>
        <p>Bug fixes.</p>
        <p>
          Improve font rendering. Enable or improve compilation when not
          linking to libxaw3d.
        </p>
      </description>
    </release>
    <release version="3.2.9" date="2023-08-23">
      <description>
        <p>
          Use fontconfig and libxft for finding fonts and drawing
          anti-aliased text.
        </p>
        <p>
          Write fig-files utf-8 encoded, independent of the locale
          encoding. Depending on the output language, glyphs beyond
          the range of 8-bit encodings can be processed and displayed.
        </p>
      </description>
    </release>
